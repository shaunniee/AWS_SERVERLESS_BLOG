      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "arn": "arn:aws:cloudfront::721937028630:function/admin-strip-api-prefix",
            "code": "function handler(event) {\n  var request = event.request;\n  if (request.uri.indexOf('/api/') === 0) {\n    request.uri = request.uri.substring(4); // \"/api/users\" -\u003e \"/users\"\n  }\n  return request;\n}\n",
            "comment": "",
            "etag": "ETVPDKIKX0DER",
